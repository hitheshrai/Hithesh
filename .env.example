# PostHog project token, from Project settings in PostHog. Starts with phc_.
#
# This is the only analytics variable. The ingest host is not configurable:
# events are proxied through /ingest on this domain (see vercel.json) so that
# content blockers cannot drop them.
#
# Vite inlines this at BUILD time. Setting it in Vercel does nothing until a
# new deployment is built.
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_token
